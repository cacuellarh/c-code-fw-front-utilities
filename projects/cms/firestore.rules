rules_version = '2';

// Rules of the Firestore database of the CMS (project c-code-bf1fd).
// Paste them in Firebase console → Firestore Database → Rules → Publish.
//
// - Content (sites and their collections) is public to read: the sites' builds read it
//   without credentials. It is the same content the public sites already show.
// - Admins (a document admins/{email}) create and configure sites: name, sections, Deploy Hook
//   and who edits each one.
// - Editors (sites/{id}/private/access.editors) only edit the content of their sites, upload
//   images and publish.
// - private/ (editors, Deploy Hook) and history/ are only readable by editors.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInEmail() {
      return request.auth != null && request.auth.token.email_verified == true
        ? request.auth.token.email : '';
    }

    function isAdmin() {
      return signedInEmail() != '' && exists(/databases/$(database)/documents/admins/$(signedInEmail()));
    }

    function isEditor(site) {
      return isAdmin() || (
        exists(/databases/$(database)/documents/sites/$(site)/private/access) &&
        signedInEmail() in get(/databases/$(database)/documents/sites/$(site)/private/access).data.editors
      );
    }

    // Each person can only check whether they are an admin. The list is edited in the console.
    match /admins/{email} {
      allow get: if signedInEmail() == email;
    }

    match /sites/{site} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Editors only touch the dates of saving and publishing; renaming and hiding sections is for admins.
      allow update: if isAdmin() || (
        isEditor(site) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'publishedAt'])
      );

      match /collections/{collection} {
        allow read: if true;
        // Editors save existing sections; adding and removing sections is for admins.
        allow update: if isEditor(site);
        allow create, delete: if isAdmin();
      }

      // Image library: public like the rest of the site's content (the build downloads it).
      match /media/{image} {
        allow read: if true;
        allow write: if isEditor(site);

        match /data/{variant} {
          allow read: if true;
          allow write: if isEditor(site);
        }
      }

      match /history/{entry} {
        allow read, create: if isEditor(site);
      }

      match /private/{doc} {
        // Editors read the Deploy Hook to publish, and their own access to know they can edit.
        allow read: if isEditor(site);
        allow write: if isAdmin();
      }
    }
  }
}
